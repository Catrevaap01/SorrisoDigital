{
  "name": "teodontoangola",
  "version": "1.0.0",
  "description": "Sistema Digital de Odontologia de Angola",
  "author": "TeOdonto Angola <suporte@teodontoangola.ao>",
  "main": "index.tsx",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export": "expo export --platform web",
    "clean:dist": "npx rimraf dist",
    "build:web": "npm run clean:dist && expo export --platform web && node scripts/prepare-pwa.js",
    "desktop": "npm run build:web && electron desktop/main.cjs",
    "desktop:dev": "set ELECTRON_DEV=true&& electron desktop/main.cjs",
    "clean:release": "npx rimraf release",
    "dist:win": "npm run clean:release && npm run build:web && electron-builder --win nsis",
    "preview": "npm run build:web && npx serve -s dist -p 3000",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "postinstall": "node scripts/patch-hermes.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@supabase/supabase-js": "^2.97.0",
    "@types/qrcode": "^1.5.6",
    "date-fns": "^2.30.0",
    "expo": "^57.0.9",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "^57.0.8",
    "expo-print": "~15.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "~14.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.9",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~54.0.10",
    "electron": "^41.7.1",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2"
  },
  "build": {
    "appId": "com.teodontoangola.desktop",
    "productName": "TeOdonto Angola",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeOdonto Angola"
    }
  }
}
